{
  "name": "wubbys-treat-run",
  "private": true,
  "description": "Wubby's Treat Run: a short pixel platformer in vanilla JavaScript and HTML5 Canvas.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npx -y http-server . -p 8000 -c-1",
    "start": "npm run dev",
    "build": "node scripts/build-dist.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "check": "node tools/check-levels.js",
    "test": "npm run lint && npm run check"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
