# Copy to .env.local for `vercel dev`. Never commit real values.

# Redis (either pair works; the Vercel Marketplace Upstash integration sets the KV_* names)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Random secret (32 bytes, base64 or hex) that salts the IP hashes used for rate limiting
LOVE_HASH_SALT=
